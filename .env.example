# Required: private single-owner login
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SESSION_SECRET=replace-with-an-independent-random-secret-at-least-24-characters
# Paid AI providers (configure only the tools you plan to use)
RUNWAYML_API_SECRET=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
# Local and Railway runtime
DATA_DIR=./data
PORT=3000
MAX_VIDEO_MB=200
# Railway: set TRUST_PROXY=1, NODE_ENV=production, DATA_DIR=/data
# Railway volume at /data may require RAILWAY_RUN_UID=0
TRUST_PROXY=0
