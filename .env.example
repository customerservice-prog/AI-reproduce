# Required to access the private studio
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-different-long-random-secret
# Video editing (Runway Developer API - billed separately)
RUNWAYML_API_SECRET=
# Original AI music via Replicate / ElevenLabs Music - billed separately
REPLICATE_API_TOKEN=
# Optional
DATA_DIR=./data
PORT=3000
MAX_VIDEO_MB=200
# Enable when behind Railway/another HTTPS reverse proxy
TRUST_PROXY=1
